# ==============================================================
# Akıllı Donanım ve Cihaz Seçim Sistemi (KDS) - Ortam Değişkenleri
# ==============================================================

# Canlı donanım ve fiyat verisi çeken harici JSON uç noktası URL'si.
# Dış API, GitHub raw JSON veya şirket içi JSON servis URL'si tanımlanabilir.
# (Erişilemezse veya tanımlanmazsa sistem etl/live_feed_backup.json dosyasına fallback yapar)
LIVE_DEVICES_FEED_URL=https://raw.githubusercontent.com/datasets/hardware-prices/master/devices.json

# Web Sunucusu Port Numarası (Varsayılan: 5050)
PORT=5050

# SQLite Veritabanı Dosya Yolu (İsteğe bağlı, varsayılan: data/devices.db)
# KDS_DB_PATH=data/devices.db
